# ============================================================
# AI-拓客 后端配置模板（复制为 .env 后填入你自己的密钥）
# 注意：.env 含密钥，请勿提交到 git / 共享给无关人员
# ============================================================

# ---------- AI 大模型（DeepSeek，用于 AI创作 / 私信解析 / 意向分级）----------
DEEPSEEK_API_KEY=在此填入你的DeepSeek_API_Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- 产品业务配置（前端"设置"页也可改）----------
PRODUCT_NAME=示例产品
PRODUCT_DESC=这是一款示例产品，用于演示拓客工具的功能
PRODUCT_DETAIL=示例产品的详细功能描述
TARGET_CUSTOMER=需要示例产品的企业或个人用户
PRODUCT_ADVANTAGES=高效便捷、成本低廉、易于使用

# ---------- 高德地图 Web 服务 Key（地图获客模块，仅后端调用，不暴露前端）----------
AMAP_KEY=在此填入你的高德Web服务Key

# ---------- 平台接入（抖音 / 小红书 官方开放平台，需企业号/专业号资质）----------
# 公网可访问的 HTTPS 地址（Webhook 推不到 localhost）；本地自测可用 /api/platform/simulate
PUBLIC_BASE_URL=https://你的公网地址
DOUYIN_CLIENT_ID=
DOUYIN_CLIENT_SECRET=
XHS_CLIENT_ID=
XHS_CLIENT_SECRET=
